# Copy this file to .env and fill in your key. Get $5 free credits at
# https://console.anthropic.com (no credit card required).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Functionality #6 (remote MCP server): leave both unset to run the
# offers server locally (default, functionality #5). Set
# OFFERS_REMOTE_URL to the deployed server's base URL (e.g. a Cloud Run
# URL) to make the chatbot talk to it over HTTP instead - see
# src/servers/offers_server/Dockerfile and README for how to deploy it.
# OFFERS_REMOTE_URL=https://offers-mcp-xxxxxxxxxx.a.run.app
# OFFERS_AUTH_TOKEN=change-me-to-a-random-secret
